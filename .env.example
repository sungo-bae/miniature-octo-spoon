# 공공데이터포털(data.go.kr)에서 아래 서비스를 활용신청한 뒤
# 발급받은 서비스키(인증키)를 설정하세요.
#   - 한국천문연구원_특일 정보
#   - 기상청_단기예보 조회서비스
# 두 서비스 모두 data.go.kr 발급 키를 공용으로 사용합니다.
DATA_GO_KR_SERVICE_KEY=

# aT 한국농수산식품유통공사 KAMIS Open API (data.go.kr과 별개 발급 절차).
# https://www.kamis.or.kr/customer/reference/openapi_list.do 에서 발급받으세요.
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
