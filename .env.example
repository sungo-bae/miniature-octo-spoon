# Postgres
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/sabangnet_forecast

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# 테넌트 API 자격증명 암호화에 사용하는 키 (Fernet.generate_key()로 생성, 절대 커밋 금지)
CREDENTIAL_ENCRYPTION_KEY=

# 사방넷 연동 공통 설정
SABANGNET_API_BASE_URL=https://sandbox-api.sbfulfillment.co.kr
SABANGNET_USE_SANDBOX=true

APP_ENV=local
LOG_LEVEL=INFO
