{
  "_comment": "공공데이터포털에서 활용신청한 API의 명세(요청 URL, 파라미터, 응답 필드명)를 보고 아래 값을 채운 뒤 kordi.json으로 저장하세요. 인증키는 이 파일이 아니라 환경변수(key_env)에 둡니다.",
  "url": "https://apis.data.go.kr/<기관코드>/<서비스명>/<오퍼레이션>",
  "key_env": "DATA_GO_KR_SERVICE_KEY",
  "key_param": "serviceKey",
  "page_param": "pageNo",
  "size_param": "numOfRows",
  "page_size": 100,
  "max_pages": 200,
  "params": { "_type": "json" },
  "items_path": "response.body.items.item",
  "field_map": {
    "source_id": "<공고ID 필드명>",
    "title": "<공고제목 필드명>",
    "org_name": "<기관명 필드명>",
    "sido": "<시도 필드명>",
    "sigungu": "<시군구 필드명>",
    "category": "<직종 필드명>",
    "employment_type": "<사업유형 필드명>",
    "wage_amount": "<급여 필드명>",
    "wage_unit": "<급여단위 필드명: hour/day/month/year로 변환 필요 시 비워두기>",
    "hours_per_week": "<주당 근무시간 필드명>",
    "posted_date": "<게시일 필드명>",
    "deadline_date": "<마감일 필드명>"
  }
}
